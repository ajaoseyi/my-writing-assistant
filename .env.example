# Grammar checking and all LLM operations (https://console.groq.com)
GROQ_API_KEY=

# Fact checking — required for factCheck() tool (https://tavily.com)
TAVILY_API_KEY=

# Server port (default: 3001)
PORT=3001

# Google Docs integration — create credentials at https://console.cloud.google.com/apis/credentials
# Enable: Google Drive API + Google Docs API. OAuth type: Web application.
# Authorized redirect URI: http://localhost:3001/api/gdocs/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/gdocs/callback
APP_URL=http://localhost:3000