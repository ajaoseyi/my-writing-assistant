# Grammar checking and all LLM operations (https://console.groq.com)
GROQ_API_KEY=

# Fact checking — required for factCheck() tool (https://tavily.com)
TAVILY_API_KEY=

# Plagiarism checking — requires a Copyleaks account (https://copyleaks.com)
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=

# Server port (default: 3001)
PORT=3001
